{
  "name": "communication-control-plane",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "dev:worker": "tsx watch src/server/worker-main.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/main.js",
    "start:worker": "node dist/server/worker-main.js",
    "test": "vitest run --config vitest.config.ts",
    "test:postgres": "vitest run --config vitest.config.ts src/server/postgres.integration.test.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "openapi:export": "node scripts/export-openapi.mjs",
    "migrate:postgres": "node scripts/migrate-postgres.mjs",
    "bootstrap:pilot": "node scripts/bootstrap-pilot.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.0",
    "fastify": "^5.6.2",
    "jose": "^6.2.3",
    "oidc-client-ts": "^3.5.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
