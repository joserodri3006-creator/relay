NODE_ENV=production
PORT=3001
DATABASE_URL=postgres://relay_api_login:CHANGE_ME@db.example.eu:5432/relay?sslmode=verify-full
AUTH_MODE=oidc
OIDC_ISSUER=https://identity.example.eu
OIDC_AUDIENCE=relay-api
OIDC_JWKS_URL=https://identity.example.eu/.well-known/jwks.json
OIDC_CLIENT_ID=relay-web
OIDC_SCOPES=openid profile
PUBLIC_APP_URL=https://pilot.example.eu
GOOGLE_OAUTH_CLIENT_ID=INJECT_FROM_SECRET_STORE
GOOGLE_OAUTH_CLIENT_SECRET=INJECT_FROM_SECRET_STORE
GOOGLE_OAUTH_REDIRECT_URI=https://pilot.example.eu/api/oauth/google/callback
SECRET_VAULT_MODE=gcp
GOOGLE_CLOUD_PROJECT=relay-production-project
CORS_ORIGINS=https://pilot.example.eu
CONNECTOR_SECRET_REF=connector/pilot-v1
CONNECTOR_SECRET=INJECT_FROM_MANAGED_SECRET_STORE_MINIMUM_32_CHARS
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=15000
